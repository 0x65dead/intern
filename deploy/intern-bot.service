# intern — Telegram bot as a systemd service.
#
# The bot is a long-running daemon by design: it holds the Telegram long-poll
# connection open, runs auto-refreshing panels on timers, and waits out countdowns
# that can be hours long. Started from an SSH session it dies with that session —
# usually at the least convenient moment, since the whole point is to be alive at
# T-0 for a drop nobody is awake for.
#
# Install:
#   sudo cp deploy/intern-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now intern-bot
#   systemctl status intern-bot
#   journalctl -u intern-bot -f
#
# Adjust User= and the paths below if intern does not live in /root/intern/intern.

[Unit]
Description=intern — OpenSea SeaDrop mint bot (Telegram)
Documentation=https://github.com/your/intern
# Telegram and the RPC endpoints are both remote, so there is no point starting
# before the network is actually usable.
After=network-online.target
Wants=network-online.target

# Never give up restarting. This belongs in [Unit] — systemd has read it here
# since v229 and silently ignores it in [Service], where it sat until
# `systemd-analyze verify` was actually run against this file. That mattered: the
# default is 5 starts per 10s, and with RestartSec=2 a bot crash-looping on a
# transient RPC failure would hit the limit in ten seconds and stay down for the
# night — the exact outcome this line exists to prevent.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/intern/intern

# .env holds PRIVATE_KEYS and TELEGRAM_BOT_TOKEN. systemd reads it directly rather
# than the process shelling out for it, so the values never pass through a command
# line — /proc/<pid>/cmdline is world-readable and would expose them to every user
# on the box.
EnvironmentFile=/root/intern/intern/.env

ExecStart=/usr/bin/node dist/bot/index.js

# Always restart, including on a clean exit. A bot that has stopped is a bot that
# misses the mint, and every exit path worth distinguishing is already fatal on
# purpose: a bad token or a second instance polling the same token exits non-zero
# and will restart-loop visibly in the journal rather than fail silently.
Restart=always
# Two seconds, not five. This is the gap between the bot dying and the bot being
# back on the long-poll, and it is time the operator is unrepresented for. Short
# enough to matter near T-0, long enough not to hammer Telegram's 401 on a token
# that is genuinely wrong.
RestartSec=2

# ── Watchdog ────────────────────────────────────────────────────────────────
#
# Restart=always only catches a process that has exited. The failure that actually
# loses a mint is quieter: the process is alive, the event loop turns, and the
# Telegram poll has wedged behind a socket that will never answer. systemd cannot
# see that from the outside, so the bot reports in.
#
# The bot pings every WatchdogSec/2 — but ONLY while its poll loop is completing
# round trips (see src/bot/watchdog.ts). A wedged loop stops the pings, this
# deadline expires, and systemd kills and restarts the process. That restart is
# the recovery, which is why the whole thing is worth having.
#
# 90s: the poll's own timeout is 50s, so a healthy quiet chat can legitimately be
# silent for most of a minute. Anything tighter restarts working bots.
WatchdogSec=90

# Required. The bot has no unix-datagram socket of its own — Node's dgram is
# UDP-only — so it sends WATCHDOG=1 by spawning systemd-notify, and that is an
# auxiliary process, not the main one. With the default NotifyAccess=none (Type is
# not notify) every ping would be dropped and the bot would be killed every 90s.
NotifyAccess=all

# SIGKILL, not systemd's default SIGABRT — this one is a key-exposure fix, and it
# was found by running it rather than by reading the docs.
#
# A watchdog kill with SIGABRT dumps core. On a stock Ubuntu box that dump goes to
# apport, which writes ~50MB of raw process memory to /var/crash/ — and this
# process holds PRIVATE_KEYS in that memory. Measured directly: a sentinel string
# held in a variable was recovered from the resulting file twice. LimitCORE=0 does
# NOT prevent this, because the kernel ignores RLIMIT_CORE when core_pattern is a
# pipe, which it is whenever apport or systemd-coredump is installed.
#
# SIGKILL cannot be caught and never dumps core, so the keys stay in RAM and die
# with the process. Verified: same stall, same restart, /var/crash/ empty.
#
# The cost is that KillSignal=SIGINT's graceful abort does not run on a watchdog
# kill. That is the right trade — the watchdog only fires after the poll loop has
# been unresponsive for WatchdogSec, so there is nothing graceful left to do, and
# the crash-safety journal (src/core/runstate.ts) is what covers an interrupted
# broadcast. The next start reports any unfinished run rather than resuming it.
WatchdogSignal=SIGKILL

# Belt and braces. Useless against a piped core_pattern, as above, but it is the
# thing that works on a box with the plain kernel pattern and it costs nothing.
LimitCORE=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=intern-bot

# Shutdown: SIGINT is what the bot installs a handler for, and it uses it to abort
# in-flight runs rather than leaving transactions half-dispatched.
KillSignal=SIGINT
TimeoutStopSec=30

# Hardening. This process holds private keys, so it gets no more of the system than
# it needs: no new privileges, a private /tmp, read-only everything except its own
# directory, and no access to other users' home directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/intern/intern
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
